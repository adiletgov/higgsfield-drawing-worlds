{
  "name": "higgsfield-drawing-worlds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "package:site": "npm run build && node scripts/package-site.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev --port 8787",
    "format": "prettier --write src tests scripts *.json *.md docs",
    "format:check": "prettier --check src tests scripts *.json *.md docs"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260921.0-alpha",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
