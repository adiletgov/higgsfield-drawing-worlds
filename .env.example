# Copy to .dev.vars for LOCAL Wrangler preview. Never commit real values.
# Production: enter these values in private Site settings, not ChatGPT messages.
OWNER_EMAIL=you@example.com
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Localhost-only demo. Omit or set both false on a hosted deployment.
# Demo mode does not call Higgsfield and does not prove API integration.
ALLOW_LOCAL_OWNER=true
DEMO_MODE=true
